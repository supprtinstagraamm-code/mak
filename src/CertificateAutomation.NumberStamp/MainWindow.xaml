<Window x:Class="CertificateAutomation.NumberStamp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت شمارهٔ نامه" FlowDirection="RightToLeft"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- حالت جمع‌شده: یک دکمهٔ گرد شناور -->
        <Border x:Name="CollapsedButton" Width="54" Height="54" CornerRadius="27"
                Background="#2F6FED" Cursor="Hand"
                MouseLeftButtonDown="CollapsedButton_MouseLeftButtonDown"
                MouseRightButtonUp="CollapsedButton_MouseRightButtonUp"
                ToolTip="ثبت شمارهٔ نامهٔ جدید (کلیک کنید) — برای جابه‌جایی بکشید">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <TextBlock Text="＋" Foreground="White" FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
        </Border>

        <!-- حالت بازشده: پنل ثبت شماره -->
        <Border x:Name="ExpandedPanel" Width="300" Background="#FFFFFF" CornerRadius="10"
                Visibility="Collapsed" BorderBrush="#D9DEE6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="✕" FontSize="13" Foreground="#8A93A6" Cursor="Hand"
                               DockPanel.Dock="Left" MouseLeftButtonUp="CloseIcon_MouseLeftButtonUp"
                               ToolTip="بستن" />
                    <TextBlock Text="ثبت شمارهٔ نامهٔ خارج از سامانه" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1F2430" TextWrapping="Wrap" />
                </DockPanel>

                <Border Grid.Row="1" Background="#EEF3FF" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="شمارهٔ بعدی که رزرو می‌شود:" FontSize="11" Foreground="#5B6478" />
                        <TextBlock x:Name="NextNumberText" Text="…" FontSize="18" FontWeight="Bold"
                                   Foreground="#2F6FED" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="توضیحات (مثلاً: نامهٔ دستی به ادارهٔ کار...)"
                           Foreground="#8A93A6" FontSize="11" Margin="0,0,0,3" />
                <TextBox x:Name="DescriptionBox" Grid.Row="3" MinHeight="60" MaxHeight="120"
                         Margin="0,0,0,6"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="8" FontSize="13" BorderBrush="#D9DEE6" BorderThickness="1" />

                <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="12" TextWrapping="Wrap"
                           Margin="0,2,0,8" Visibility="Collapsed" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SubmitButton" Content="ثبت شماره" Style="{StaticResource ActionButton}"
                            Background="#2F6FED" Foreground="White" Margin="0,0,8,0"
                            Click="SubmitButton_Click" />
                    <Button Content="انصراف" Style="{StaticResource ActionButton}"
                            Background="#EDEFF3" Foreground="#3A4150" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

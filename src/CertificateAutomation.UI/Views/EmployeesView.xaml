<UserControl x:Class="CertificateAutomation.UI.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- نوار ابزار: جستجو + بارگذاری -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                             VerticalAlignment="Center" />
                    <!-- متن راهنما: وقتی فیلد خالی است نمایش داده می‌شود -->
                    <TextBlock Text="جستجو: نام، نام خانوادگی، کد ملی، شماره عضویت…"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.7"
                               FontFamily="{DynamicResource AppFont}" FontSize="13"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={x:Static conv:EmptyToVisibilityConverter.Instance}}" />
                </Grid>

                <Button Grid.Column="1" Content="پاک کردن" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Command="{Binding LoadCommand}"
                        Click="ClearSearch" />

                <Button Grid.Column="2" Content="بارگذاری از Excel" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Command="{Binding ImportFromExcelCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
            </Grid>
        </Border>

        <!-- نوار وضعیت -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                       Foreground="{DynamicResource AccentBrush}" />
        </Border>

        <!-- شمارنده پایین -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تعداد کل افراد فعال: " Style="{StaticResource TextSubtitle}" />
                <TextBlock Text="{Binding TotalCount, Converter={StaticResource Fa}}"
                           Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
                <TextBlock Text="   |   نمایش داده‌شده: " Style="{StaticResource TextSubtitle}" />
                <TextBlock Text="{Binding Employees.Count, Converter={StaticResource Fa}}"
                           Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- جدول کارکنان -->
        <Border Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                          RowHeight="34" FontSize="12"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Width="*" Binding="{Binding FirstName}" />
                        <DataGridTextColumn Header="نام خانوادگی" Width="*" Binding="{Binding LastName}" />
                        <DataGridTextColumn Header="کد ملی" Width="130"
                                            Binding="{Binding NationalId, Converter={StaticResource Fa}}" />
                        <DataGridTextColumn Header="شماره عضویت" Width="120"
                                            Binding="{Binding MembershipNo, Converter={StaticResource Fa}}" />
                        <DataGridTextColumn Header="سمت" Width="*" Binding="{Binding Position}" />
                        <DataGridTextColumn Header="واحد" Width="*" Binding="{Binding Unit}" />
                        <DataGridTextColumn Header="شماره تماس" Width="120"
                                            Binding="{Binding Phone, Converter={StaticResource Fa}}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- پیام خالی بودن -->
                <TextBlock Text="موردی برای نمایش وجود ندارد."
                           Style="{StaticResource TextSubtitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Employees.Count, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

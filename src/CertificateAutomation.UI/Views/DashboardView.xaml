<UserControl x:Class="CertificateAutomation.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />

        <!-- کارت آماری -->
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- نوار ابزار بالا -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="به‌روزرسانی آمار" Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ردیف کارت‌های آماری -->
                <UniformGrid Columns="4" Margin="0,0,0,4">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="نامه‌های امروز" Style="{StaticResource TextSubtitle}" />
                            <TextBlock Style="{StaticResource StatValue}" Margin="0,6,0,0"
                                       Text="{Binding TodayCount, Converter={StaticResource Fa}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="نامه‌های این ماه" Style="{StaticResource TextSubtitle}" />
                            <TextBlock Style="{StaticResource StatValue}" Margin="0,6,0,0"
                                       Text="{Binding MonthCount, Converter={StaticResource Fa}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="آخرین شماره نامه" Style="{StaticResource TextSubtitle}" />
                            <TextBlock Style="{StaticResource StatValue}" FontSize="22" Margin="0,8,0,0"
                                       Text="{Binding LastLetterNumber, Converter={StaticResource Fa}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="تعداد افراد ثبت‌شده" Style="{StaticResource TextSubtitle}" />
                            <TextBlock Style="{StaticResource StatValue}" Margin="0,6,0,0"
                                       Text="{Binding EmployeeCount, Converter={StaticResource Fa}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ویجت‌های یادآور و آمار سریع پرسنل -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- یادآورهای این ماه -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="یادآورهای این ماه" Style="{StaticResource TextBase}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PendingReminderCount, Converter={StaticResource Fa}}"
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text=" مورد باقی‌مانده" Style="{StaticResource TextSubtitle}"
                                           VerticalAlignment="Bottom" Margin="6,0,0,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding NextReminderText}" Style="{StaticResource TextSubtitle}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding NextReminderText, Converter={StaticResource NullVis}}" />
                            <TextBlock Text="✓ همهٔ یادآورهای این ماه انجام شده‌اند." Style="{StaticResource TextSubtitle}"
                                       Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding PendingReminderCount, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!-- آمار سریع پرسنل -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="نگاه سریع به پرسنل" Style="{StaticResource TextBase}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding QuickStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource TextSubtitle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- آخرین فعالیت‌ها -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="آخرین نامه‌های صادرشده" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                        <DataGrid ItemsSource="{Binding RecentLetters}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0" RowHeight="34"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}"
                                  MaxHeight="320" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره نامه" Width="130"
                                                    Binding="{Binding LetterNumber, Converter={StaticResource Fa}}" />
                                <DataGridTextColumn Header="تاریخ" Width="110"
                                                    Binding="{Binding JalaliDate, Converter={StaticResource Fa}}" />
                                <DataGridTextColumn Header="ساعت" Width="70"
                                                    Binding="{Binding IssuedTime, Converter={StaticResource Fa}}" />
                                <DataGridTextColumn Header="نام شخص" Width="*"
                                                    Binding="{Binding SnapFullName}" />
                                <DataGridTextColumn Header="نوع نامه" Width="*"
                                                    Binding="{Binding SnapTemplateTitle}" />
                                <DataGridTextColumn Header="دفعات چاپ" Width="90"
                                                    Binding="{Binding PrintCount, Converter={StaticResource Fa}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,10,0,0"
                                   Text="هنوز نامه‌ای صادر نشده است. پس از تکمیل فاز صدور، فهرست اینجا نمایش داده می‌شود."
                                   Visibility="{Binding RecentLetters.Count, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<UserControl x:Class="CertificateAutomation.UI.Views.ProjectComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:PersianDigitsConverter x:Key="Fa" />
    </UserControl.Resources>

    <DockPanel>
        <!-- انتخاب فیلد گروه‌بندی و معیارها -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="مقایسه بر اساس (مثلاً پروژه)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding GroupField}"
                              DisplayMemberPath="DisplayName" FontFamily="{DynamicResource AppFont}"
                              Padding="8,6" FontSize="13" MaxDropDownHeight="380" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="میانگین کدام فیلد عددی (اختیاری)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding NumericMetricField}"
                              DisplayMemberPath="DisplayName" FontFamily="{DynamicResource AppFont}"
                              Padding="8,6" FontSize="13" MaxDropDownHeight="380" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="پرتکرارترین کدام فیلد دسته‌ای (اختیاری)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding CategoryMetricField}"
                              DisplayMemberPath="DisplayName" FontFamily="{DynamicResource AppFont}"
                              Padding="8,6" FontSize="13" MaxDropDownHeight="380" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                       Foreground="{DynamicResource AccentBrush}" />
        </Border>

        <!-- جدول مقایسه -->
        <Border Style="{StaticResource Card}" Padding="4">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      BorderThickness="0" RowHeight="36" FontSize="13"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="گروه" Width="2*" Binding="{Binding GroupLabel}" />
                    <DataGridTextColumn Header="تعداد نفرات" Width="*"
                                        Binding="{Binding Count, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="درصد از کل" Width="*"
                                        Binding="{Binding Percent, Converter={StaticResource Fa}, StringFormat={}{0}٪}" />
                    <DataGridTextColumn Header="معیار عددی" Width="2*" Binding="{Binding MetricValue}" />
                    <DataGridTextColumn Header="پرتکرارترین" Width="2*" Binding="{Binding TopCategoryValue}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

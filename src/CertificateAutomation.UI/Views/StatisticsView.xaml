<UserControl x:Class="CertificateAutomation.UI.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:PersianDigitsConverter x:Key="Fa" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- کارت‌های آمار کلیدی -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Highlights}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="12" Padding="18,14" Margin="0,0,12,12"
                                MinWidth="185" MinHeight="82">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource TextSubtitle}"
                                           FontSize="11.5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- نوار فیلتر و میان‌برها -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="تفکیک بر اساس:" Style="{StaticResource TextSubtitle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />

                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterFields}"
                              SelectedItem="{Binding SelectedFilterField}" DisplayMemberPath="DisplayName"
                              FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                              MaxDropDownHeight="380" Margin="0,0,10,0" />

                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterValues}"
                              SelectedItem="{Binding SelectedFilterValue}"
                              FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                              MaxDropDownHeight="380" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="خروجی Excel" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                Command="{Binding ExportExcelCommand}"
                                ToolTip="فایل Excel راست‌چین همراه با تصویر نمودار و جدول داده" />
                        <Button Content="خروجی PDF" Style="{StaticResource GhostButton}"
                                Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                Command="{Binding ExportPdfCommand}"
                                ToolTip="گزارش PDF راست‌چین همراه با تصویر نمودار و جدول داده" />
                        <Button Content="CSV" Style="{StaticResource GhostButton}"
                                Padding="12,6" FontSize="12"
                                Command="{Binding ExportCsvCommand}" ToolTip="فقط داده‌های خام، بدون نمودار" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,8,0,10" TextWrapping="Wrap"
                           Text="با انتخاب یک مقدار (مثلاً یک پروژه)، هم آمار بالای صفحه و هم نمودار پایین فقط برای همان زیرمجموعه محاسبه می‌شوند. «همه» یعنی بدون فیلتر." />

                <!-- میان‌برهای آماده -->
                <WrapPanel>
                    <TextBlock Text="تحلیل‌های آماده:" Style="{StaticResource TextSubtitle}"
                               VerticalAlignment="Center" Margin="0,0,10,6" FontWeight="SemiBold" />
                    <Button Content="پراکندگی استانی" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="province" />
                    <Button Content="توزیع سنی" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="age" />
                    <Button Content="مدارک تحصیلی" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="education" />
                    <Button Content="وضعیت تاهل" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="marital" />
                    <Button Content="نوع عضویت" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="membership" />
                    <Button Content="میانگین سن در هر استان" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                            Padding="10,5" FontSize="12"
                            Command="{Binding PresetCommand}" CommandParameter="ageByProvince" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- نوار انتخاب فیلد و نوع نمودار -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="متغیر اصلی" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedFieldX}"
                              DisplayMemberPath="DisplayName" IsEditable="False"
                              FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                              MaxDropDownHeight="380" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="متغیر دوم (اختیاری — برای مقایسه)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedFieldY}"
                              DisplayMemberPath="DisplayName" IsEditable="False"
                              FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                              MaxDropDownHeight="380" />
                </StackPanel>

                <Button Grid.Column="2" Content="حذف متغیر دوم" Style="{StaticResource GhostButton}"
                        VerticalAlignment="Bottom" Margin="0,0,10,0"
                        Command="{Binding ClearSecondFieldCommand}" />

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="نوع نمودار" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ChartTypes}" SelectedItem="{Binding SelectedChartType}"
                              MinWidth="120" FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13" />
                </StackPanel>

                <Button Grid.Column="4" Content="به‌روزرسانی" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom" Command="{Binding LoadCommand}" />
            </Grid>
        </Border>

        <!-- خلاصهٔ آماری زیر نمودار -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource TextSubtitle}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>
        </Border>

        <!-- ناحیهٔ رسم نمودار -->
        <Border Style="{StaticResource Card}" Padding="18" MinHeight="460">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding AnalysisTitle}"
                           Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="16"
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                           Style="{StaticResource TextSubtitle}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- جدول داده کنار نمودار -->
                    <Border Grid.Column="1" Width="230" Margin="14,0,0,0"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0"
                            Padding="12,0,0,0"
                            Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="جدول داده"
                                       Style="{StaticResource TextBase}" FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TableRows}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                      BorderThickness="0" RowHeight="28" FontSize="11.5"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="عنوان" Width="*" Binding="{Binding Label}" />
                                    <DataGridTextColumn Header="تعداد" Width="55"
                                                        Binding="{Binding Count, Converter={StaticResource Fa}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- نمودار روی این بوم رسم می‌شود -->
                    <ScrollViewer Grid.Column="0" x:Name="ChartScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- FlowDirection چپ‌به‌راست تا مختصات رسم آینه نشود؛
                             متن‌های فارسی جداگانه راست‌چین می‌شوند. -->
                        <Canvas x:Name="ChartCanvas" Background="Transparent"
                                FlowDirection="LeftToRight" />
                    </ScrollViewer>

                    <TextBlock Grid.Column="0" Text="داده‌ای برای نمایش نیست. یک متغیر انتخاب کنید."
                               Style="{StaticResource TextSubtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasData, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

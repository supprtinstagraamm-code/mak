<UserControl x:Class="CertificateAutomation.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- فیلترهای جستجو -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="جستجوی سریع" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}"
                                 Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="شمارهٔ نامه" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding LetterNumber}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="کد ملی" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NationalId}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="از تاریخ (۱۴۰۵/۰۱/۰۱)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="تا تاریخ" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding ToDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نوع نامه" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TemplateFilter}" SelectedItem="{Binding SelectedTemplateFilter}"
                                  DisplayMemberPath="Title" FontFamily="{DynamicResource AppFont}"
                                  Padding="8,6" FontSize="13" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Content="جستجو" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
                    <Button Content="پاک کردن فیلترها" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- نوار عملیات و شمارنده -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="تعداد نتایج: " Style="{StaticResource TextSubtitle}" />
                    <TextBlock Text="{Binding ResultCount, Converter={StaticResource Fa}}"
                               Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                               Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="چاپ مجدد" Style="{StaticResource GhostButton}"
                            Command="{Binding ReprintCommand}" />
                    <Button Content="حذف سابقه (مدیر)" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                            Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- جدول نتایج -->
        <Border Style="{StaticResource Card}" Padding="4">
            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedLetter}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" GridLinesVisibility="Horizontal" Background="Transparent"
                      BorderThickness="0" RowHeight="32" FontSize="12"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شمارهٔ نامه" Width="120"
                                        Binding="{Binding LetterNumber, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="تاریخ" Width="100"
                                        Binding="{Binding JalaliDate, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="ساعت" Width="60"
                                        Binding="{Binding IssuedTime, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="نام شخص" Width="*" Binding="{Binding SnapFullName}" />
                    <DataGridTextColumn Header="کد ملی" Width="120"
                                        Binding="{Binding SnapNationalId, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="نوع نامه" Width="*" Binding="{Binding SnapTemplateTitle}" />
                    <DataGridTextColumn Header="دفعات چاپ" Width="80"
                                        Binding="{Binding PrintCount, Converter={StaticResource Fa}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

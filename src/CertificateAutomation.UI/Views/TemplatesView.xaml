<UserControl x:Class="CertificateAutomation.UI.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- نوار ابزار -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="پوشهٔ قالب‌ها:" Style="{StaticResource TextSubtitle}" />
                    <TextBlock Text="{Binding TemplatesFolder}" Style="{StaticResource TextBase}"
                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="باز کردن پوشه" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Command="{Binding OpenTemplatesFolderCommand}" />

                <Button Grid.Column="2" Content="همگام‌سازی قالب‌ها" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Command="{Binding SyncCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- دو ستون: فهرست قالب‌ها | فیلدهای قالب انتخابی -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- فهرست قالب‌ها -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="4">
                <Grid>
                    <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                              RowHeight="36" FontSize="12" SelectionMode="Single"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عنوان قالب" Width="*" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="نام فایل" Width="*" Binding="{Binding FileName}" />
                            <DataGridTextColumn Header="نسخه پیش‌فرض" Width="90"
                                                Binding="{Binding DefaultCopies, Converter={StaticResource Fa}}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="قالبی برای نمایش نیست."
                               Style="{StaticResource TextSubtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Templates.Count, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
                </Grid>
            </Border>

            <!-- ستون کناری: دسته‌بندی، فیلدهای قالب، و فیلدهای در دسترس -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- دسته‌بندی قابل ویرایش -->
                        <TextBlock Text="دستهٔ این قالب" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="می‌توانید از فهرست انتخاب کنید یا دستهٔ کاملاً جدیدی تایپ کنید." />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" IsEditable="True"
                                      ItemsSource="{Binding Categories}"
                                      Text="{Binding EditableCategory, UpdateSourceTrigger=PropertyChanged}"
                                      FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                                      Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="ذخیره" Style="{StaticResource GhostButton}"
                                    Command="{Binding SaveCategoryCommand}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,14" />

                        <!-- فیلدهای شناسایی‌شدهٔ این قالب -->
                        <TextBlock Text="فیلدهای این قالب" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="این کلیدها در فایل Word یافت شده‌اند و هنگام صدور با مقدار واقعی جایگزین می‌شوند." />
                        <ItemsControl ItemsSource="{Binding SelectedPlaceholders}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WindowBackground}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{}{{" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" />
                                            <TextBlock Text="{}}}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,14" />

                        <!-- همهٔ فیلدهای در دسترس از Excel -->
                        <TextBlock Text="فیلدهای در دسترس (از Excel)" Style="{StaticResource TextBase}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="روی هر فیلد کلیک کنید تا کپی شود، سپس در فایل Word بچسبانید." />
                        <ItemsControl ItemsSource="{Binding AvailableFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.CopyFieldCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}"
                                            Padding="8,4" Margin="0,0,6,6" FontSize="11" Cursor="Hand"
                                            ToolTip="کلیک برای کپی">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

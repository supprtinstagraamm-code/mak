<UserControl x:Class="CertificateAutomation.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="PathRow" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- حالت قفل: مدیر وارد نشده -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Center"
                MaxWidth="440" Margin="0,40,0,0"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="🔒 بخش محافظت‌شده" Style="{StaticResource TextBase}"
                           FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource TextSubtitle}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="تنظیمات و عملیات حساس فقط برای مدیر در دسترس است. برای ادامه وارد شوید." Margin="0,0,0,16" />
                <Button Content="ورود مدیر" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Command="{Binding LoginCommand}" />
                <TextBlock Style="{StaticResource TextSubtitle}" TextAlignment="Center" Margin="0,12,0,0"
                           Text="رمز پیش‌فرض: admin / admin123" Opacity="0.7" />
            </StackPanel>
        </Border>

        <!-- حالت باز: فرم تنظیمات -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsUnlocked, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <!-- اطلاعات شرکت -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="اطلاعات شرکت" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="نام شرکت" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding CompanyName}" Margin="0,0,0,10" />
                        <TextBlock Text="مسیر لوگو" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathRow}" Text="{Binding LogoPath}" />
                            <Button Grid.Column="1" Content="انتخاب…" Style="{StaticResource GhostButton}" Command="{Binding BrowseLogoCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- مسیرها -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="مسیرها" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="فایل Excel کارکنان" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathRow}" Text="{Binding ExcelPath}" />
                            <Button Grid.Column="1" Content="انتخاب…" Style="{StaticResource GhostButton}" Command="{Binding BrowseExcelCommand}" />
                        </Grid>

                        <TextBlock Text="پوشهٔ قالب‌های Word" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathRow}" Text="{Binding TemplatesFolder}" />
                            <Button Grid.Column="1" Content="انتخاب…" Style="{StaticResource GhostButton}" Command="{Binding BrowseTemplatesCommand}" />
                        </Grid>

                        <TextBlock Text="پوشهٔ خروجی نامه‌ها" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathRow}" Text="{Binding OutputFolder}" />
                            <Button Grid.Column="1" Content="انتخاب…" Style="{StaticResource GhostButton}" Command="{Binding BrowseOutputCommand}" />
                        </Grid>

                        <TextBlock Text="پوشهٔ نسخهٔ پشتیبان" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PathRow}" Text="{Binding BackupFolder}" />
                            <Button Grid.Column="1" Content="انتخاب…" Style="{StaticResource GhostButton}" Command="{Binding BrowseBackupCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- چاپ و شماره -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="چاپ و شماره‌گذاری" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="چاپگر پیش‌فرض" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                                          FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="قالب شمارهٔ نامه" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NumberFormat}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,6,0,0" Opacity="0.75"
                                   Text="نمونهٔ قالب: {year}/{serial:00000} ← 1405/00001" />

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,14,0,14" />

                        <TextBlock Text="شمارندهٔ سال جاری (فقط مدیر)" Style="{StaticResource TextSubtitle}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource AppTextBox}" Width="120" Text="{Binding CurrentSerial}" />
                            <Button Content="ثبت شماره" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding UpdateSerialCommand}" />
                            <TextBlock Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="نامهٔ بعدی = این عدد + ۱" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- نمایش -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="نمایش" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox Content="نمایش ارقام به‌صورت فارسی" IsChecked="{Binding UsePersianDigits}"
                                  FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="ذخیرهٔ خودکار خروجی PDF هنگام صدور" IsChecked="{Binding ArchivePdfEnabled}"
                                  FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="اجرای خودکار برنامه هنگام روشن شدن ویندوز" IsChecked="{Binding AutoStartEnabled}"
                                  FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Style="{StaticResource TextSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="توصیه می‌شود این گزینه فعال باشد تا یادآورهای ماهانه همیشه در پس‌زمینه (سینی سیستم) بررسی شوند، حتی اگر برنامه را دستی باز نکنید." />
                    </StackPanel>
                </Border>

                <!-- نسخهٔ پشتیبان -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="نسخهٔ پشتیبان" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextSubtitle}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="نسخهٔ پشتیبان شامل پایگاه داده، تنظیمات و قالب‌ها در یک فایل ZIP است." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="تهیهٔ نسخهٔ پشتیبان" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" />
                            <Button Content="بازیابی از پشتیبان" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RestoreBackupCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- دکمه‌های پایانی -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,20">
                    <Button Content="✓ ذخیرهٔ تنظیمات" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    <Button Content="خروج مدیر" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="CertificateAutomation.UI.Views.AdvancedSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:PersianDigitsConverter x:Key="Fa" />
    </UserControl.Resources>

    <DockPanel>
        <!-- شرط‌های جستجو -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="شرط‌های جستجو (همهٔ شرط‌ها با هم — AND)" Style="{StaticResource TextBase}"
                           FontWeight="SemiBold" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding Conditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableFields}"
                                          SelectedItem="{Binding Field}" DisplayMemberPath="DisplayName"
                                          FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                                          MaxDropDownHeight="380" Margin="0,0,8,0" />

                                <ComboBox Grid.Column="1" ItemsSource="{Binding Operators}"
                                          SelectedItem="{Binding Operator}" Width="130"
                                          FontFamily="{DynamicResource AppFont}" Padding="8,6" FontSize="13"
                                          Margin="0,0,8,0" />

                                <TextBox Grid.Column="2" Style="{StaticResource AppTextBox}"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" />

                                <Button Grid.Column="3" Content="حذف" Style="{StaticResource GhostButton}"
                                        Padding="10,6" FontSize="12"
                                        Command="{Binding DataContext.RemoveConditionCommand,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ شرط جدید" Style="{StaticResource GhostButton}"
                            Padding="10,6" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding AddConditionCommand}" />
                    <Button Content="جستجو" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- شمارنده و پیام -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تعداد نتایج: " Style="{StaticResource TextSubtitle}" />
                <TextBlock Text="{Binding ResultCount, Converter={StaticResource Fa}}"
                           Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSubtitle}"
                           Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />
            </StackPanel>
        </Border>

        <!-- نتایج -->
        <Border Style="{StaticResource Card}" Padding="4">
            <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      BorderThickness="0" RowHeight="32" FontSize="12"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="نام" Width="*" Binding="{Binding FullName}" />
                    <DataGridTextColumn Header="کد ملی" Width="120"
                                        Binding="{Binding NationalId, Converter={StaticResource Fa}}" />
                    <DataGridTextColumn Header="سمت" Width="*" Binding="{Binding Position}" />
                    <DataGridTextColumn Header="واحد" Width="*" Binding="{Binding Unit}" />
                    <DataGridTextColumn Header="فیلدهای مطابقت‌یافته" Width="2*" Binding="{Binding MatchedFieldsText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

<UserControl x:Class="CertificateAutomation.UI.Views.DataQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CertificateAutomation.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:PersianDigitsConverter x:Key="Fa" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="SeverityBar" TargetType="Border">
            <Setter Property="Width" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="error">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- خلاصه بالای صفحه -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="تعداد کل رکورد" Style="{StaticResource TextSubtitle}" FontSize="11" />
                        <TextBlock Text="{Binding TotalRecords, Converter={StaticResource Fa}}"
                                   FontSize="19" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="تعداد کل مشکلات" Style="{StaticResource TextSubtitle}" FontSize="11" />
                        <TextBlock Text="{Binding TotalIssues, Converter={StaticResource Fa}}"
                                   FontSize="19" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Button Content="بررسی مجدد" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Command="{Binding ScanCommand}" />
            </StackPanel>
        </Border>

        <!-- پیام «مشکلی نیست» -->
        <Border Style="{StaticResource Card}" Padding="30" DockPanel.Dock="Top"
                Visibility="{Binding HasNoIssues, Converter={StaticResource BoolVis}}">
            <TextBlock Text="✓ هیچ مشکلی در داده‌ها یافت نشد." FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SeverityBar}" Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextSubtitle}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ExamplesText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"
                                               FontStyle="Italic" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource WindowBackground}"
                                        CornerRadius="14" Padding="12,5" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Count, Converter={StaticResource Fa}}"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

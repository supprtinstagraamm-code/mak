<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- پالت تم روشن -->
    <Color x:Key="PrimaryColor">#1E3A5F</Color>
    <Color x:Key="AccentColor">#0E7C86</Color>

    <SolidColorBrush x:Key="PrimaryBrush"      Color="#1E3A5F" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2A4E7E" />
    <SolidColorBrush x:Key="AccentBrush"       Color="#0E7C86" />
    <SolidColorBrush x:Key="WindowBackground"  Color="#F7F8FA" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#1E3A5F" />
    <SolidColorBrush x:Key="CardBackground"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushSoft"   Color="#E3E7ED" />
    <SolidColorBrush x:Key="TextPrimary"       Color="#1B2430" />
    <SolidColorBrush x:Key="TextSecondary"     Color="#6B7684" />
    <SolidColorBrush x:Key="TextOnPrimary"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush"      Color="#1F9254" />
    <SolidColorBrush x:Key="DangerBrush"       Color="#C0392B" />
    <SolidColorBrush x:Key="WarningBrush"      Color="#E0A800" />

</ResourceDictionary>
